# ---------------------------------------------------
# Laravel & PHP
# ---------------------------------------------------
/vendor
/node_modules
# Symlinked storage folder
/public/storage
# Encryption keys
/storage/*.key
# Cache, sessions, views
/storage/framework/*
# Log files
/storage/logs/*
# Uploaded public files
/storage/app/public/*
# Uploaded private files (optional)
/storage/app/private/*
# DocuSign RSA keys (IMPORTANT!)
/storage/app/docusign/*.key
!/storage/framework/.gitignore
!/storage/logs/.gitignore
!/storage/app/public/.gitignore
!/storage/app/private/.gitignore
# Compiled bootstrap files
/bootstrap/cache/*.php

# ---------------------------------------------------
# Environment & Config
# ---------------------------------------------------
.env
# Any other env files
.env.*
# Except the example
!.env.example

# ---------------------------------------------------
# IDEs & Editors
# ---------------------------------------------------
/.idea
/.vscode
*.swp
*.swo
*.swn
*.bak

# ---------------------------------------------------
# NPM / Vite build outputs
# ---------------------------------------------------
/public/js/*.js
/public/css/*.css
/public/mix-manifest.json
/public/hot
/public/build
/build

# ---------------------------------------------------
# Composer lock file
# ---------------------------------------------------
composer.lock
.phpunit.result.cache
